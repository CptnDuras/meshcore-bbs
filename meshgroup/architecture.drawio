<mxfile host="app.diagrams.net" type="device">
  <diagram id="arch" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;meshgroup@xerokuhl.com&lt;/b&gt; &amp;mdash; one Lambda, everything else managed (AWS us-west-2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="lane_mail" value="Mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6F8;strokeColor=#CBD5DD;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontColor=#667583;fontSize=11;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="45" width="1190" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="lane_web" value="Web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6F8;strokeColor=#CBD5DD;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontColor=#667583;fontSize=11;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="400" width="470" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;A member's mail app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;writes to the list address&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#667583;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ses_in" value="&lt;b&gt;SES receiving&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rule set meshgroup, spam + DMARC scan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#9C2335;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="260" y="70" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;S3 mailbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;raw mail, expires in 7 days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=#557311;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ses_out" value="&lt;b&gt;SES sending&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;configuration set meshgroup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#9C2335;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="790" y="70" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="inbox" value="&lt;b&gt;Members' inboxes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;post + footer + leave link&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#667583;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="1030" y="70" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="lambda" value="&lt;b style=&quot;font-size:15px&quot;&gt;Lambda: meshgroup&lt;/b&gt;&lt;br&gt;Python 3.13&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;mail rules, web pages, owner page&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#0A7872;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="400" y="235" width="260" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="ddb" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;members, daily limits,&lt;br&gt;owner password hash&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=#8F1A95;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="790" y="235" width="190" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="sns" value="&lt;b&gt;SNS topic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;bounces and complaints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=#A50F58;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1030" y="235" width="160" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;visitors, the owner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#667583;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="40" y="425" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="apigw" value="&lt;b&gt;API Gateway (HTTP API)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;groups.xerokuhl.com, ACM certificate,&lt;br&gt;throttled, no other address&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#6330B8;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="260" y="420" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="r53" value="&lt;b&gt;Route 53 (xerokuhl.com)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MX, DKIM, SPF, DMARC,&lt;br&gt;groups alias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#6330B8;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="235" width="190" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="emails the list" style="endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#F3F6F8;" edge="1" parent="1" source="user" target="ses_in">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="stores the raw message" style="endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#F3F6F8;" edge="1" parent="1" source="ses_in" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="invokes, with the scan result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;strokeColor=#0A7872;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ses_in" target="lambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="reads, then deletes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="sends one message per member" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;strokeColor=#0A7872;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="ses_out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="delivers" style="endArrow=classic;html=1;strokeColor=#0A7872;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#F3F6F8;" edge="1" parent="1" source="ses_out" target="inbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="read / write" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="ddb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="delivery reports" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#F3F6F8;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ses_out" target="sns">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="a bounce or complaint takes the address off the list" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sns" target="lambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="https" style="endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#F3F6F8;" edge="1" parent="1" source="browser" target="apigw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="page requests: sign-up, leave, /admin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;strokeColor=#0A7872;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="lambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="MX record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;dashed=1;strokeColor=#8C4FFF;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#F3F6F8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="r53" target="ses_in">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="groups alias" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;dashed=1;strokeColor=#8C4FFF;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r53" target="apigw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Teal arrows: the list's own path (mail in, wake the Lambda, one copy per member out; web pages in).&lt;br&gt;Dashed purple: DNS records, set up once.&lt;br&gt;Colours follow AWS service categories. SES is still in the sandbox until AWS approves production access." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#CBD5DD;fontSize=11;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="520" y="425" width="670" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="post" name="One post">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t" value="&lt;b&gt;What happens to one post&lt;/b&gt; (inside the Lambda, in this order)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="700" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="p0" value="Mail for the list address arrives from SES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#667583;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="Not a repeat (SES can retry the same message)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#667583;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="Spam and virus scan passed, sender verified (DMARC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#667583;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="Not automatic, bulk or a bounce; under 1 MB; has text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#667583;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="Sender is an active member" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#667583;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="Not just a &quot;STOP&quot; request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#667583;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="Within the limits: 3 a day each, 20 a day, 300 people" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#667583;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;Send every other member a copy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;footer: who it is from, a link to share, their own leave link&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0A7872;strokeColor=#075753;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="380" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;Dropped silently&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;logged, never answered,&lt;br&gt;so the list can't be used to send mail at anyone:&lt;br&gt;repeats, failed scans, machine mail, strangers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7E3DE;strokeColor=#A33F2C;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="540" y="120" width="260" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Taken off the list&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;nothing is posted or sent back&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7E3DE;strokeColor=#A33F2C;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Dropped silently&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;over a limit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7E3DE;strokeColor=#A33F2C;fontColor=#19232E;" vertex="1" parent="1">
          <mxGeometry x="540" y="570" width="260" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="a0" value="" style="endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a1" value="" style="endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="" style="endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="" style="endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="" style="endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="" style="endArrow=classic;html=1;strokeColor=#667583;strokeWidth=1.5;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="" style="endArrow=classic;html=1;strokeColor=#0A7872;strokeWidth=2.5;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="f1" value="repeat" style="endArrow=classic;html=1;strokeColor=#A33F2C;strokeWidth=1.5;fontSize=11;fontColor=#A33F2C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.078;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" value="fails" style="endArrow=classic;html=1;strokeColor=#A33F2C;strokeWidth=1.5;fontSize=11;fontColor=#A33F2C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.359;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" value="fails" style="endArrow=classic;html=1;strokeColor=#A33F2C;strokeWidth=1.5;fontSize=11;fontColor=#A33F2C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.641;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" value="not a member" style="endArrow=classic;html=1;strokeColor=#A33F2C;strokeWidth=1.5;fontSize=11;fontColor=#A33F2C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.922;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="it is STOP" style="endArrow=classic;html=1;strokeColor=#A33F2C;strokeWidth=1.5;fontSize=11;fontColor=#A33F2C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" value="over a limit" style="endArrow=classic;html=1;strokeColor=#A33F2C;strokeWidth=1.5;fontSize=11;fontColor=#A33F2C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
